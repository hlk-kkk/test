# PicTacticAgent Environment Configuration

# ===================
# Provider 选择
# ===================
# 选择一个 provider: gemini_web | jiekouai | gemini | antigravity
# 只需配置对应 provider 的 key/cookie，即可同时支持生图和 LLM 评估功能
DEFAULT_PROVIDER=gemini_web

# ===================
# 场景 1: Jiekouai 中转站（推荐）
# ===================
# Jiekouai 是一个 API 中转代理服务，同时支持：
#   - 图片生成（文生图 + 图片编辑）via /v3 端点
#   - LLM 评估（提示词增强、图片打分）via /openai 端点
# 获取 API Key: https://api.jiekou.ai
JIEKOUAI_API_KEY=your-jiekouai-api-key
JIEKOUAI_API_BASE_URL=https://api.jiekou.ai/v3
JIEKOUAI_LLM_BASE_URL=https://api.jiekou.ai/openai
JIEKOUAI_LLM_MODEL=gpt-5-mini        # LLM 模型，用于提示词增强和图片评分（gpt-5-mini / gpt-4o）

# ===================
# 场景 2: 官方 Gemini API
# ===================
# Get your API key from: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-google-gemini-api-key
GEMINI_MODEL=gemini-3-pro-image-preview    # 生图模型
GEMINI_LLM_MODEL=gemini-3-flash-preview    # 评估模型

# ===================
# 场景 3: Antigravity 反代（仅支持文生图）
# ===================
# 注意：Antigravity 不支持图片编辑（IMAGE_TO_IMAGE）
ANTIGRAVITY_API_KEY=your-antigravity-api-key
ANTIGRAVITY_API_BASE_URL=http://127.0.0.1:8045/v1
ANTIGRAVITY_MODEL=gemini-3-pro-image       # 生图模型
ANTIGRAVITY_LLM_MODEL=gemini-3-flash       # 评估模型

# ===================
# 场景 4: Gemini Web（逆向代理，使用 Google 账号 Cookie，免费）
# ===================
# 通过 gemini-webapi 库直接与 gemini.google.com 交互，无需 API Key
# 需要从浏览器中提取 Google 账号的 Cookie
# Cookie 获取方法：登录 gemini.google.com → F12 打开开发者工具 → Application → Cookies
GEMINI_WEB_SECURE_1PSID=your-__Secure-1PSID-cookie-value
GEMINI_WEB_SECURE_1PSIDTS=your-__Secure-1PSIDTS-cookie-value
GEMINI_WEB_PROXY=                                  # 代理地址（可选，如 http://127.0.0.1:7890）
GEMINI_WEB_MODEL=gemini-3-pro                      # 生图模型（gemini-3-pro / gemini-3-flash）

# ===================
# [已废弃] OpenAI API (向后兼容)
# ===================
# 如果使用上方新配置，无需设置以下项
# OPENAI_API_KEY=sk-your-openai-api-key
# OPENAI_API_BASE_URL=https://api.jiekou.ai/openai
# VISION_LLM_MODEL=gpt-4o

# ===================
# 默认图片生成设置
# ===================
DEFAULT_ASPECT_RATIO=16:9
DEFAULT_IMAGE_SIZE=2K
DEFAULT_IMAGES_PER_ROUND=5
DEFAULT_MAX_ROUNDS=3
DEFAULT_QUALITY_THRESHOLD=0.7

# ===================
# Storage
# ===================
STORAGE_TYPE=local
STORAGE_PATH=./storage/images

# ===================
# Application
# ===================
# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3019

# ===================
# Database
# ===================
DB_PATH=./data/pictactic.db

# ===================
# Internal API Key (CLI → API)
# ===================
# 留空则后端启动时自动生成（推荐）
INTERNAL_API_KEY=

# ===================
# JWT Authentication
# ===================
JWT_SECRET_KEY=your-random-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440
JWT_REFRESH_TOKEN_EXPIRE_DAYS=90

# ===================
# OAuth - GitHub
# ===================
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_CALLBACK_URL=http://localhost:3019/auth/callback/github

# ===================
# OAuth - Google
# ===================
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3019/auth/callback/google

# ===================
# SMTP (Email)
# ===================
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=PicTacticAgent
SMTP_USE_TLS=true
